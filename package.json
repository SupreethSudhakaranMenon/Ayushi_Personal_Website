{
  "name": "v4",
  "description": "Personal Website V4",
  "version": "1.0.0",
  "author": "Brittany Chiang <brittany.chiang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bchiang7/v4"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "deploy": "gatsby clean && gatsby build --prefix-paths && gh-pages -d public"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "^3.2.1",
    "babel-plugin-styled-components": "^2.1.4",
    "gatsby": "^4.25.7",
    "gatsby-plugin-google-analytics": "^4.25.0",
    "gatsby-plugin-image": "^2.25.0",
    "gatsby-plugin-manifest": "^4.25.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-offline": "^5.25.0",
    "gatsby-plugin-react-helmet": "^5.25.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^4.25.0",
    "gatsby-plugin-sitemap": "^5.25.0",
    "gatsby-plugin-styled-components": "^5.25.0",
    "gatsby-remark-external-links": "^0.0.4",
    "gatsby-remark-images": "^6.25.0",
    "gatsby-remark-prismjs": "^6.25.0",
    "gatsby-source-filesystem": "^4.25.0",
    "gatsby-transformer-remark": "^5.25.0",
    "gatsby-transformer-sharp": "^4.25.0",
    "lodash": "^4.17.21",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "react-transition-group": "^4.4.5",
    "scrollreveal": "^4.0.9",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@upstatement/eslint-config": "^1.0.1",
    "@upstatement/prettier-config": "^1.0.0",
    "babel-eslint": "^10.1.0",
    "babel-preset-gatsby": "^2.25.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "gatsby-plugin-root-import": "^2.0.9",
    "gatsby-remark-code-titles": "^1.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "^2.8.8"
  }
}
